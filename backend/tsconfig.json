{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "esModuleInterop": true,
    
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // --- ADD THIS SECTION ---
    // This ensures TypeScript looks in your src/types folder for custom definitions
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  // --- ADD THIS SECTION ---
  // This tells TypeScript to compile everything inside the src folder
  "include": ["src/**/*", "../frontend/src/contexts/profile.ts", "../frontend/src/components/ProtectedRoute.tsx"]
}